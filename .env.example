# Base URL of the FastAPI backend. Leave unset to use "/api" on this site, which is forwarded to the backend
# by Vite in dev (localhost:8000), by nginx in Docker, and by the rewrite in vercel.json on Vercel.
# Keep the API on the same site as the frontend: the login session is a SameSite=Strict HttpOnly cookie,
# which browsers won't send to an API on another site (e.g. calling *.onrender.com directly from *.vercel.app).
# VITE_API_URL=/api
